# Keep Study Support disabled until the desired provider is configured.
AI_CHAT_ENABLED=false
# Optional Ollama Cloud key. When set, this takes priority over Groq and local Ollama.
OLLAMA_API_KEY=
# Optional cloud provider (Groq). When set, this takes priority over local Ollama.
GROQ_API_KEY=
# Required for production Groq rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Used only when GROQ_API_KEY is not set in local development.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2:latest
